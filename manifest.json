{
  "manifest_version": 3,
  "name": "DigitalArkivet to FamilySearch",
  "version": "1.0",
  "description": "A tool to extract data from Norwegian DigitalArkivet and format it for FamilySearch.org SourceBox",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "https://*.familysearch.org/*",
    "https://*.digitalarkivet.no/*",
    "https://www.dokpro.uio.no/*",
    "https://ws.geonorge.no/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.familysearch.org/*"
      ],
      "js": [
        "fs_person.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon32.svg"
      ],
      "matches": [
        "https://www.familysearch.org/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
