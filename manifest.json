{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "version": "1.6.0",
  "description": "__MSG_description__",
  "default_locale": "en",
  "permissions": [
    "activeTab",
    "alarms",
    "scripting",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "https://www.familysearch.org/*",
    "https://www.digitalarkivet.no/*",
    "https://www.dokpro.uio.no/*",
    "https://ws.geonorge.no/*"
  ],
  "optional_host_permissions": [
    "https://api.github.com/*",
    "https://release-assets.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "i18n.js",
      "i18n_strings.js",
      "da_places.js",
      "farms.js",
      "releases.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "__MSG_name__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.familysearch.org/*"
      ],
      "js": [
        "fs_person.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon32.svg"
      ],
      "matches": [
        "https://www.familysearch.org/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "arkivet2fs@dude4linux",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
